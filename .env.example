NEO4J_AUTH=neo4j/please_change_me
NEO4J_URI=bolt://localhost:7687
# 可选；不填时会尝试根据 NEO4J_URI 推导为 http://<host>:7474/db/neo4j/tx/commit
NEO4J_TX_URL=http://localhost:7474/db/neo4j/tx/commit

# 定时导入容器：启动时是否立即跑一次（false 则只在 06:00 执行）
RUN_ON_STARTUP=true

# Web 应用在宿主机的端口（容器内固定监听 80）
WEB_PORT=8080

# Cloudflare Tunnel（Named Tunnel）的凭据。
# 在 Cloudflare Zero Trust -> Networks -> Tunnels 创建隧道后复制 token 填到这里；
# 留空时 cloudflared 容器无法建立隧道（不影响其它服务）。
TUNNEL_TOKEN=
